{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whizkidal.github.io/Therapy-Games/catalogue.schema.json",
  "title": "Therapy Games catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogueVersion", "updated", "games"],
  "properties": {
    "catalogueVersion": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/game" }
    }
  },
  "$defs": {
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "url", "therapyArea", "presentationTags", "levelsSupported", "configurable", "supports_repair", "status", "version", "lastUpdated"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://whizkidal\\.github\\.io/Therapy-Games/" },
        "therapyArea": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "presentationTags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "levelsSupported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "configurable": { "type": "boolean" },
        "supports_repair": { "type": "boolean" },
        "status": { "enum": ["planned", "built", "tested", "clinically-reviewed", "released"] },
        "version": { "type": "string", "minLength": 1 },
        "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "summary": { "type": "string" },
        "kind": { "enum": ["game", "clinician-tool", "guide", "directory", "tracker", "catalogue", "tool"] },
        "statusNote": { "type": "string" }
      }
    }
  }
}
